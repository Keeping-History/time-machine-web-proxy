{
	"name": "time-machine-web-proxy",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"packageManager": "pnpm@10.26.0",
	"scripts": {
		"build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/timemachine.js && printf '{\"type\":\"commonjs\"}' > dist/package.json",
		"typecheck": "tsc --noEmit",
		"test": "jest --passWithNoTests",
		"lint": "biome lint .",
		"check": "biome check .",
		"check:fix": "biome check --write ."
	},
	"dependencies": {
		"bullmq": "^5.76.10",
		"ioredis": "^5.10.1",
		"pino": "^10.3.1",
		"wayback-machine-downloader": "https://registry.npmjs.org/wayback-machine-downloader/-/wayback-machine-downloader-0.5.0.tgz",
		"ws": "^8.18.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.1.0",
		"@types/ws": "^8.5.14",
		"esbuild": "^0.25.0",
		"jest": "^30.4.2",
		"ts-jest": "^29.4.10",
		"ts-node": "^10.9.2",
		"turbo": "^2.9.14",
		"typescript": "~5.9.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"volta": {
		"node": "25.2.0"
	}
}
