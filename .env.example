# Time Machine Web Proxy — example environment configuration.
#
# Copy to .env (local) or .env.prod (production) and adjust values.
# Never commit a populated .env or .env.prod.

# --- Server ---
TIMEMACHINE_PORT=8765
LISTENER=0.0.0.0
# Required when running behind a reverse proxy or on Cloud Run.
# PROXY_BASE_URL=https://your-service.run.app

# --- Archive lookup ---
ARCHIVE_TIME=19980101000000
PROXY_PREFIX=

# --- Cache ---
CACHE_DIR=/app/cache
CACHE_ENABLED=true
# Bearer token required for DELETE /cache. Empty = unprotected.
CACHE_CLEAR_TOKEN=

# --- CORS / whitelist ---
CORS_ORIGIN=http://localhost:5173
WHITELIST_HOSTS=*

# --- WebSocket ---
WS_KEEPALIVE_MS=30000

# --- Redis / BullMQ ---
# Use redis://default:<password>@<host>:6379 for Memorystore AUTH.
REDIS_URL=redis://localhost:6379
BULLMQ_PREFIX=tm

# --- Worker / crawler ---
DOMAIN_CRAWL_ENABLED=true
WORKER_CONCURRENCY=2
# 1/sec → 60 req/min, under Wayback's sustained-IP-block threshold.
WORKER_RATE_LIMIT_PER_SEC=1
DOWNLOADER_THREADS_COUNT=3
# CDX preflight cap. At default (~3000 URLs/page) ≈ 150k URLs per crawl.
CRAWL_MAX_CDX_PAGES=50

# --- Snapshot resolver ---
# Widening search windows (in days) for finding the closest Wayback snapshot
# at-or-before the requested time. Tried in order; 0 = unbounded (since Wayback's
# earliest 1996 crawl). CSV of non-negative integers.
SNAPSHOT_WINDOW_DAYS=30,365,3650,0
# When true and no snapshot exists at-or-before the requested time, fall back
# to the earliest snapshot AFTER the requested time. Default false → strict
# "no later than" semantic; 404 when no earlier snapshot exists.
ALLOW_LATER_FALLBACK=false

# --- Outbound HTTP proxy (ProxyMesh / Squid) ---
# CSV of one or more proxy URLs. Empty = direct connection.
# Example (single): http://us-wa-load-balancer.proxymesh.com:31280
# Example (multi):  http://us-wa.proxymesh.com:31280,http://uk.proxymesh.com:31280
OUTBOUND_PROXY_URLS=
# When more than one URL is set, choose how outbound requests are routed:
#   sequential = round-robin through the list (default).
#   random     = pick uniformly per request.
# Values are case-insensitive. Ignored when OUTBOUND_PROXY_URLS has a single URL.
OUTBOUND_PROXY_CHOOSER=sequential
# Empty = IP whitelist authentication. Credentials apply to every URL in the list.
OUTBOUND_PROXY_USERNAME=
# Required when OUTBOUND_PROXY_USERNAME is set. Inject via Secret Manager in prod.
OUTBOUND_PROXY_PASSWORD=
# Base cooldown (seconds) after a proxy fails — it is taken out of rotation for
# this long, then re-probed. Each consecutive re-probe failure extends the
# cooldown linearly (X, 2X, 3X, ...). Startup probe failures use the same path.
OUTBOUND_PROXY_COOLDOWN_SECONDS=60
