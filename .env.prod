# --- Server ---
TIMEMACHINE_PORT=8765
LISTENER=0.0.0.0
PROXY_BASE_URL=https://timemachine.911realtime.org

# --- Archive lookup ---
ARCHIVE_TIME=20010901000000
PROXY_PREFIX=

# --- Cache ---
CACHE_DIR=/app/cache
CACHE_ENABLED=true
# set to a strong random string if you want DELETE /cache protected
CACHE_CLEAR_TOKEN=t4t3r5414d
# --- CORS / whitelist ---
CORS_ORIGIN=*
WHITELIST_HOSTS=*

# --- WebSocket ---
WS_KEEPALIVE_MS=30000

# --- Redis / BullMQ ---
BULLMQ_PREFIX=tm

# --- Worker / crawler ---
DOMAIN_CRAWL_ENABLED=true
WORKER_CONCURRENCY=5
WORKER_RATE_LIMIT_PER_SEC=1
DOWNLOADER_THREADS_COUNT=15
CRAWL_MAX_CDX_PAGES=50

# --- Outbound HTTP proxy ---
# OUTBOUND_PROXY_URLS=http://us-wa-load-balancer.proxymesh.com:31280
# OUTBOUND_PROXY_CHOOSER=random
# OUTBOUND_PROXY_USERNAME=robbiebyrd
